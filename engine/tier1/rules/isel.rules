# (qp) adds r = k, r with k = 1, 2, 4, 8: r + qp * k, since qp is 0/1
# (a predicated counter; one lea, no flags, no branch).

rule select_add1 cost 1
  match   (SELECT $c (ADD $f (CONST 1))@value $f)
  outputs $d = (SELECT $c (ADD $f (CONST 1))@value $f)@value
  emit    lea64 $d, [$f + $c * 1]
  flags   preserved
end

rule select_add2 cost 1
  match   (SELECT $c (ADD $f (CONST 2))@value $f)
  outputs $d = (SELECT $c (ADD $f (CONST 2))@value $f)@value
  emit    lea64 $d, [$f + $c * 2]
  flags   preserved
end

rule select_add4 cost 1
  match   (SELECT $c (ADD $f (CONST 4))@value $f)
  outputs $d = (SELECT $c (ADD $f (CONST 4))@value $f)@value
  emit    lea64 $d, [$f + $c * 4]
  flags   preserved
end

rule select_add8 cost 1
  match   (SELECT $c (ADD $f (CONST 8))@value $f)
  outputs $d = (SELECT $c (ADD $f (CONST 8))@value $f)@value
  emit    lea64 $d, [$f + $c * 8]
  flags   preserved
end

# ---------------------------------------------------------------- memory sites
# The access of a memory site (`mov rDST, [rGVA + r11]` after the tag
# check; mir.h T1_MIR_SITE). The rules prove the value side:
# ld1/ld2/ld4/ld8 zero-extend (SDM Vol.3 ld), st1..st8 write the low bytes
# (st), .acq/.rel are plain moves on WB memory under TSO. The
# address is the guest address register plus the window delta $w (R11 in
# the site sequence); the window invariant host = gva + delta is hostwin's
# and is tested. Post-increments are ADD(base, inc): add_ri/add_rr.

rule load1 cost 1
  match   (LOAD #m $a)
  when    (in (bytes #m) 1)
  outputs $d = (LOAD #m $a)@value
  window  $w
  emit    load8zx $d, [$a + $w * 1]
  flags   preserved
end

rule store1 cost 1
  match   (STORE #m $a $v)
  when    (in (bytes #m) 1)
  window  $w
  emit    store8 [$a + $w * 1], $v
  flags   preserved
end

rule load2 cost 1
  match   (LOAD #m $a)
  when    (in (bytes #m) 2)
  outputs $d = (LOAD #m $a)@value
  window  $w
  emit    load16zx $d, [$a + $w * 1]
  flags   preserved
end

rule store2 cost 1
  match   (STORE #m $a $v)
  when    (in (bytes #m) 2)
  window  $w
  emit    store16 [$a + $w * 1], $v
  flags   preserved
end

rule load4 cost 1
  match   (LOAD #m $a)
  when    (in (bytes #m) 4)
  outputs $d = (LOAD #m $a)@value
  window  $w
  emit    load32 $d, [$a + $w * 1]
  flags   preserved
end

rule store4 cost 1
  match   (STORE #m $a $v)
  when    (in (bytes #m) 4)
  window  $w
  emit    store32 [$a + $w * 1], $v
  flags   preserved
end

rule load8 cost 1
  match   (LOAD #m $a)
  when    (in (bytes #m) 8)
  outputs $d = (LOAD #m $a)@value
  window  $w
  emit    load64 $d, [$a + $w * 1]
  flags   preserved
end

rule store8 cost 1
  match   (STORE #m $a $v)
  when    (in (bytes #m) 8)
  window  $w
  emit    store64 [$a + $w * 1], $v
  flags   preserved
end

# SDM Vol.3 xma.l; AMD64 IMUL's low half is independent of signedness.
rule xma_l cost 3
  match (XMA_L $a $b $c)
  outputs $d = (XMA_L $a $b $c)@value
  emit mov64 $d, $a
       imul64 $d, $b
       add64 $d, $c
  flags clobbered
end

rule xma_l_zero cost 2
  match (XMA_L $a $b (CONST 0))
  outputs $d = (XMA_L $a $b (CONST 0))@value
  emit mov64 $d, $a
       imul64 $d, $b
  flags clobbered
end

rule xma_hu cost 6
  match (XMA_HU $a $b $c)
  outputs $d = (XMA_HU $a $b $c)@value
  temps $lo $hi
  fixed $lo = rax, $hi = rdx
  emit mov64 $lo, $a
       mov64 $hi, $b
       mulpair64 $lo, $hi
       add64 $lo, $c
       adc64 $hi, 0
       mov64 $d, $hi
  flags clobbered
end

rule xma_h cost 6
  match (XMA_H $a $b $c)
  outputs $d = (XMA_H $a $b $c)@value
  temps $lo $hi
  fixed $lo = rax, $hi = rdx
  emit mov64 $lo, $a
       mov64 $hi, $b
       imulpair64 $lo, $hi
       add64 $lo, $c
       adc64 $hi, 0
       mov64 $d, $hi
  flags clobbered
end

# Byte definitions may change registers at allocation splits; normalize
# after SETcc, as in the compare rules, before using the full value.
rule frnattest cost 7
  match (FRNATTEST $sig $meta)
  outputs $d = (FRNATTEST $sig $meta)@value
  temps $tag
  emit test64 $sig, $sig
       sete8 $d
       movzx32_8 $d, $d
       cmp64 $meta, 131070
       sete8 $tag
       movzx32_8 $tag, $tag
       and64 $d, $tag
  flags clobbered
end

# Transfer fallback rules remain available if identity folding is skipped.
rule setf_sig cost 1
  match (SETF_SIG $a)
  outputs $d = (SETF_SIG $a)@value
  emit mov64 $d, $a
  flags preserved
end

rule getf_sig cost 1
  match (GETF_SIG $a)
  outputs $d = (GETF_SIG $a)@value
  emit mov64 $d, $a
  flags preserved
end
