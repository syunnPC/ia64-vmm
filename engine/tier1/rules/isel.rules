# Branches on predicate combinations (I1 values are 0/1): .unc compares
# under a predicate give AND1(qp, c) and AND1(qp, NOT1 c), e.g.
# a gather/filter loop's (p7) cmp.eq.unc p10 = ... ;; (p10) br. For 0/1 values a & ~b is
# a >u b and ~a & b is a <u b.
rule br_and1 cost 2
  match   (BRANCH (AND1 $a $b)@value $T $F)
  labels  $T $F
  emit    test64 $a, $b
          jnz    $T
          jmp    $F
  flags   dead-after
end

rule br_and1_not cost 2
  match   (BRANCH (AND1 $a (NOT1 $b)@value)@value $T $F)
  labels  $T $F
  emit    cmp64  $a, $b
          ja     $T
          jmp    $F
  flags   dead-after
end

rule br_not_and1 cost 2
  match   (BRANCH (AND1 (NOT1 $a)@value $b)@value $T $F)
  labels  $T $F
  emit    cmp64  $a, $b
          jb     $T
          jmp    $F
  flags   dead-after
end

rule br_or1 cost 3
  match   (BRANCH (OR1 $a $b)@value $T $F)
  labels  $T $F
  emit    test64 $a, $a
          jnz    $T
          test64 $b, $b
          jnz    $T
          jmp    $F
  flags   dead-after
end

# ---------------------------------------------------------------- generic branches
# br.cond on an I1 value in a register: the fallback when the compare is a
# cut (multi-use) value. Last, so that a tie at the BRANCH node resolves to
# the fused compare-and-branch rules above (ties by rule order); the
# matcher should compare total tree-cover cost anyway.

rule br_pred cost 2
  match   (BRANCH $c $T $F)
  labels  $T $F
  emit    test64 $c, $c
          jnz    $T
          jmp    $F
  flags   dead-after
end

rule br_not cost 2
  match   (BRANCH (NOT1 $c)@value $T $F)
  labels  $T $F
  emit    test64 $c, $c
          jz     $T
          jmp    $F
  flags   dead-after
end

# ---------------------------------------------------------------- selects
# A predicated pure result is SELECT(qp, new, old); when qp is
# a compare used only here, the compare sets the flags for the cmov
# directly. $d is tied to the old value (the false arm).

rule select_cmp_eq cost 2
  match   (SELECT (CMP eq 64 $a $b)@value $t $f)
  outputs $d = (SELECT (CMP eq 64 $a $b)@value $t $f)@value
  tie     $d = $f
  emit    cmp64   $a, $b
          cmove64 $d, $t
  flags   clobbered
end

