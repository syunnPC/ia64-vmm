# Register-constant forms (a compare whose second operand folded, e.g.
# cmp.eq p8, p9 = r16, r0 with r0 = CONST 0), and the zero tests as test.

# The zero tests first: at equal cost they win the tie (no immediate).
rule cmp_eq_zero_branch cost 2
  match   (BRANCH (CMP eq 64 $a (CONST 0))@value $T $F)
  labels  $T $F
  emit    test64    $a, $a
          je        $T
          jmp       $F
  flags   dead-after
end

rule cmp_eq_zero_ir_branch cost 2
