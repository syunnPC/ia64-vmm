# FP helper expansions (docs/floating-point.md; rulelib.py "expand"), written by
# fpfast_gen.py. Rules are tried in order; the first whose insn,
# precision, addend and host match and whose mode is enabled expands.

expand fma_s_fused
  insn      FMA
  precision s
  addend    reg
  host      fma3
  mode      exact
  emit      in $s, qp
            test64 $s, $s
            jz .skip
            in $s, fpsr
            test64 $s, 32
            jz $BAIL
            shr64 $s, (add 6 (shl #sf 3) (shl #sf 2) #sf)
            and64 $s, 0x1032
            cmp64 $s, 0x1000
            jne $BAIL
            in $s, b.meta
            and64 $s, 0x1ffff
            sub64 $s, 0xff81
            cmp64 $s, 0xfd
            ja .bz
            add64 $s, 1
            shl64 $s, 23
            movq x1, $s
            in $s, b.sig
            test64 $s, $s
            jns $BAIL
            shl64 $s, 24
            jnz $BAIL
            in $s, b.sig
            shl64 $s, 1
            shr64 $s, 41
            movq x3, $s
            por x1, x3
            in $s, b.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x3, $s
            por x1, x3
            jmp .bp
            .bz:
            in $s, b.meta
            and64 $s, 0x1ffff
            jnz $BAIL
            in $s, b.sig
            test64 $s, $s
            jnz $BAIL
            in $s, b.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x1, $s
            .bp:
            in $s, c.meta
            and64 $s, 0x1ffff
            sub64 $s, 0xff81
            cmp64 $s, 0xfd
            ja .cz
            add64 $s, 1
            shl64 $s, 23
            movq x2, $s
            in $s, c.sig
            test64 $s, $s
            jns $BAIL
            shl64 $s, 24
            jnz $BAIL
            in $s, c.sig
            shl64 $s, 1
            shr64 $s, 41
            movq x3, $s
            por x2, x3
            in $s, c.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x3, $s
            por x2, x3
            jmp .cp
            .cz:
            in $s, c.meta
            and64 $s, 0x1ffff
            jnz $BAIL
            in $s, c.sig
            test64 $s, $s
            jnz $BAIL
            in $s, c.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x2, $s
            .cp:
            in $s, a.meta
            and64 $s, 0x1ffff
            sub64 $s, 0xff81
            cmp64 $s, 0xfd
            ja .az
            add64 $s, 1
            shl64 $s, 23
            movq x0, $s
            in $s, a.sig
            test64 $s, $s
            jns $BAIL
            shl64 $s, 24
            jnz $BAIL
            in $s, a.sig
            shl64 $s, 1
            shr64 $s, 41
            movq x3, $s
            por x0, x3
            in $s, a.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x3, $s
            por x0, x3
            jmp .ap
            .az:
            in $s, a.meta
            and64 $s, 0x1ffff
            jnz $BAIL
            in $s, a.sig
            test64 $s, $s
            jnz $BAIL
            in $s, a.meta
            shr64 $s, 17
            shl64 $s, 31
            movq x0, $s
            .ap:
            vfmadd213ss x1, x2, x0
            movq $s, x1
            shl64 $s, 33
            jz .rz
            shr64 $s, 56
            sub64 $s, 1
            cmp64 $s, 0xfd
            ja $BAIL
            test64 $s, $s
            jnz .rn
            movq $s, x1
            shl64 $s, 41
            jz $BAIL
            .rn:
            movq $s, x1
            shl64 $s, 33
            shr64 $s, 56
            add64 $s, 0xff80
            movq x2, $s
            movq $s, x1
            shl64 $s, 32
            shr64 $s, 63
            shl64 $s, 17
            movq x0, $s
            por x2, x0
            out d.meta, x2
            psllq x1, 40
            pcmpeqd x3, x3
            psllq x3, 63
            por x1, x3
            out d.sig, x1
            out mf, #mf
            jmp $DONE
            .rz:
            in $s, b.sig
            test64 $s, $s
            jz .rzok
            in $s, c.sig
            test64 $s, $s
            jnz $BAIL
            .rzok:
            out d.sig, 0
            movq $s, x1
            shl64 $s, 32
            shr64 $s, 63
            shl64 $s, 17
            out d.meta, $s
            out mf, #mf
            jmp $DONE
