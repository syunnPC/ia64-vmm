# SPDX-License-Identifier: GPL-2.0-or-later
# Copy to local.env (ignored by git). Literal KEY=value, no shell quotes,
# expansion, inline comments, or export prefixes. Spaces/backslashes are literal.
# Environment wins over this file; make command-line assignments win over both.
# Relative paths resolve from the repository root.

# IA-64 GCC/binutils prefix; the built-in default is ia64-linux-gnu- via PATH.
CROSS_IA64=ia64-linux-gnu-
# MinGW-w64 x86-64 prefix for vmmcfg.efi (make vmmcfg, make usb-stick).
# MINGW_X64=x86_64-w64-mingw32-
# ACPICA compiler/disassembler and host objdump (defaults through PATH).
IASL=iasl
OBJDUMP=objdump

# Linux QEMU and its OVMF templates. Each run copies both; vars become writable.
QEMU_X86=qemu-system-x86_64
OVMF_CODE=../firmware/OVMF_CODE_4M.fd
OVMF_VARS=../firmware/OVMF_VARS_4M.fd
# Empty: prefer a configured Windows QEMU, otherwise Linux QEMU.
# Other values: win-qemu, wsl-qemu, vmware; --backend overrides this setting.
VMM_BACKEND=
# Windows backends (from WSL): QEMU and its firmware, a staging directory on a
# Windows drive, VMware Workstation, and the System32 directory when cmd.exe,
# tasklist.exe, taskkill.exe and powershell.exe are not on PATH.
# WIN_QEMU=/mnt/c/path/to/qemu/qemu-system-x86_64.exe
# WIN_QEMU_FW_CODE=/mnt/c/path/to/qemu/share/edk2-x86_64-code.fd
# WIN_QEMU_FW_VARS=/mnt/c/path/to/qemu/share/edk2-i386-vars.fd
# WIN_STAGING_DIR=/mnt/c/path/to/staging
# VMWARE_DIR=/mnt/c/path/to/VMware Workstation
# WIN_SYSTEM32=/mnt/c/Windows/System32

# VMM command line and expected exit status of the QEMU smoke test (defaults).
VMM_CMDLINE=exit=isa-debug-exit reserve_mib=128
QEMU_EXPECT_EXIT=0
# Optional options file the QEMU ESP carries as the Limine "options" module;
# its tokens come before the entry's command line and win for the same key.
# VMM_OPTIONS_FILE=vmm-options.conf

# Reference implementation for differential tests: the qemu-system-ia64
# binary and its source tree (QEMU q35 ACPI tables, firmware loader).
QEMU_IA64=../qemu-system-ia64/build/qemu-system-ia64
IA64_FORK_DIR=../qemu-system-ia64
# EDK2 workspace for regenerating firmware/edk2/generated (optional).
# EDK2_IPF_DIR=../edk2-ipf
# Python 2.7 for its BaseTools (optional; default: python2 on PATH).
# EDK2_PYTHON2=../python2/bin/python2
# Recorded host ACPI tables (DSDT.AML, SSDTn.AML) for the AML routing test,
# directories separated by ':' (optional).
# ACPI_TABLE_DIRS=acpi-tables

# Installation media for the loader tests (read-only directory) and the
# manifest describing them (format: tests/loaders/media.example.json).
IA64_IMAGES_DIR=../images
IA64_MEDIA_MANIFEST=../media.json

# Python venv with z3-solver for the Tier1 rule prover (make test-tier1-rules);
# create it with: python3 -m venv DIR && DIR/bin/pip install -r tests/tier1/rules/requirements.txt
T1_Z3_VENV=.venv-z3
# Linux test-shim scalar JIT mask: BMI1=1, BMI2=2, LZCNT=4, MOVBE=8.
IA64VMM_HOST_ISA_MASK=15

# USB boot kit (docs/real-hardware.md): the build settings (copy of
# tools/usb-stick/local.env.example), the ESP tree and an optional raw image.
USB_STICK_CONFIG=usb-stick.local.env
USB_STICK_DIR=build/usb-stick
USB_STICK_IMAGE=build/usb-stick.img
