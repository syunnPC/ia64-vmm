# SPDX-License-Identifier: GPL-2.0-or-later
# Optional: copy needed settings to local.env (ignored by git).
# Literal KEY=value; no quotes, expansion, inline comments, or export prefixes.
# Environment wins over this file; make command-line assignments win over both.
# Relative paths resolve from the repository root.

# IA-64 tool prefix (also needed by test/benchmark helpers run without make).
CROSS_IA64=ia64-linux-gnu-
# Optional MinGW-w64 prefix override for vmmcfg.efi.
# MINGW_X64=x86_64-w64-mingw32-

# Linux QEMU firmware. Backend/tool overrides: docs/running-qemu.md.
OVMF_CODE=../firmware/OVMF_CODE_4M.fd
OVMF_VARS=../firmware/OVMF_VARS_4M.fd
# Optional VMM options file for the QEMU boot image.
# VMM_OPTIONS_FILE=vmm-options.conf

# Reference emulator and source tree for differential and firmware tests.
QEMU_IA64=../qemu-system-ia64/build/qemu-system-ia64
IA64_FORK_DIR=../qemu-system-ia64
# Optional firmware regeneration tools (docs/building.md).
# EDK2_IPF_DIR=../edk2-ipf
# EDK2_PYTHON2=../python2/bin/python2
# Optional recorded ACPI table directories, separated by ':'.
# ACPI_TABLE_DIRS=acpi-tables

# Loader test media and manifest (tests/loaders/media.example.json).
IA64_IMAGES_DIR=../images
IA64_MEDIA_MANIFEST=../media.json

# Tier1 prover venv; dependencies: tests/tier1/rules/requirements.txt.
T1_Z3_VENV=.venv-z3

# USB boot kit settings and output paths (docs/real-hardware.md).
USB_STICK_CONFIG=usb-stick.local.env
USB_STICK_DIR=build/usb-stick
USB_STICK_IMAGE=build/usb-stick.img
