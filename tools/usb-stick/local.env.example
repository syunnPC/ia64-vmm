# SPDX-License-Identifier: GPL-2.0-or-later
# USB boot kit configuration (USB_STICK_CONFIG). Copy it outside the tree
# or to usb-stick.local.env at the repository root (git-ignored).
# Literal KEY=value lines; '#' starts a comment line. Format: docs/real-hardware.md.
# The boot menu is fixed. Save VMM runtime settings with Configure VMM Options.

# Optional seed for vmm-options.conf on the stick.
# VMM_OPTIONS_FILE=path/to/vmm-options.conf

# EFI variable slot pairs per firmware format: machines one stick serves (1..32).
NVRAM_PAIRS=8
